{
  "name": "@airsong/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": "./config/*.js",
    "#start/*": "./start/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#errors/*": "./app/errors/*.js",
    "#static/*": "./app/static/*.js"
  },
  "scripts": {
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "lint": "eslint --max-warnings=0 . --ext=.ts",
    "start": "node bin/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@airsong/protocol": "*",
    "proxy-addr": "^2.0.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/tsconfig": "^2.0.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@types/proxy-addr": "^2.0.3",
    "hot-hook": "^1.0.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/middleware/*.ts",
      "./start/routes.ts"
    ]
  }
}
