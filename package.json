{
  "name": "airsong-dupe",
  "version": "0.0.0",
  "private": true,
  "description": "An application that stream audio from 1 device to another. Specifically usefull when you want to stream any audio from mobile to a TV/PC",
  "license": "MIT",
  "author": "OMKAR AGRAWAL",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check:no-js": "node scripts/check_no_js.ts",
    "commit": "git-cz",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "lint": "turbo run lint",
    "lint:fix": "npm run lint:root -- --fix",
    "lint:root": "eslint --max-warnings=0 . --ext=.ts",
    "lint-build": "npm run lint && npm run build",
    "prepare": "node .husky/install.mjs",
    "release": "standard-version",
    "release:mock": "npm run release -- --dry-run",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "sort-package-json": "^4.1.0",
    "standard-version": "^9.5.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "youch": "^4.1.1",
    "youch-terminal": "^2.2.3"
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.20.0",
      "onFail": "error"
    }
  }
}
