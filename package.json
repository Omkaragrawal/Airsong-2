{
  "name": "airsong-dupe",
  "version": "0.0.0",
  "description": "An application that stream audio from 1 device to another. Specifically usefull when you want to stream any audio from mobile to a TV/PC",
  "license": "MIT",
  "author": "OMKAR AGRAWAL",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "commit": "git-cz",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings=0 . --ext=.ts",
    "lint-build": "npm run lint && npm run build",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky install",
    "release": "standard-version",
    "release:mock": "npm run release -- --dry-run",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit"
  },
    "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.7",
    "git-cz": "^4.9.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "sort-package-json": "^4.1.0",
    "standard-version": "^9.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "youch": "^4.1.1",
    "youch-terminal": "^2.2.3"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "source-map-support": "^0.5.21"
  },
    "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.20.0"
  }

}
